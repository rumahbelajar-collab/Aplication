/* =========================================================
   SALDO SISWA
   ========================================================= */

export function calculateStudentBalance(
  siswaId: string
): number {
  const transactions =
    getStudentLedger(siswaId);

  return transactions.reduce(
    (saldo, transaction) => {
      const amount =
        parseNumber(
          transaction.nominal ??
          transaction.jumlah
        );

      const type = String(
        transaction.type ??
        transaction.tipe ??
        ""
      ).toLowerCase();

      if (
        type.includes("masuk") ||
        type.includes("setor") ||
        type.includes("deposit") ||
        type.includes("tabung") ||
        type.includes("credit")
      ) {
        return saldo + amount;
      }

      if (
        type.includes("keluar") ||
        type.includes("tarik") ||
        type.includes("bayar") ||
        type.includes("debit")
      ) {
        return saldo - amount;
      }

      return saldo;
    },
    0
  );
}

/* =========================================================
   SALDO TUTOR
   ========================================================= */

export function calculateTutorBalance(
  tutorId: string
): number {
  const transactions =
    getTutorLedger(tutorId);

  return transactions.reduce(
    (saldo, transaction) => {
      const amount =
        parseNumber(
          transaction.nominal ??
          transaction.jumlah
        );

      const type = String(
        transaction.type ??
        transaction.tipe ??
        ""
      ).toLowerCase();

      if (
        type.includes("masuk") ||
        type.includes("honor") ||
        type.includes("saldo") ||
        type.includes("titipan") ||
        type.includes("credit")
      ) {
        return saldo + amount;
      }

      if (
        type.includes("keluar") ||
        type.includes("ambil") ||
        type.includes("bayar") ||
        type.includes("debit")
      ) {
        return saldo - amount;
      }

      return saldo;
    },
    0
  );
}

export function getStudentBalance(
  siswaId: string
): number {
  const database = getDatabase();

  const transactions = Array.isArray(
    database.studentLedger
  )
    ? database.studentLedger
    : [];

  return transactions.reduce(
    (saldo, transaction) => {
      const transactionStudentId =
        transaction.siswaId ??
        transaction.idSiswa;

      if (
        String(transactionStudentId) !==
        String(siswaId)
      ) {
        return saldo;
      }

      const nominal = parseNumber(
        transaction.nominal ??
        transaction.jumlah ??
        0
      );

      const type = String(
        transaction.type ??
        transaction.tipe ??
        transaction.keterangan ??
        ""
      ).toLowerCase();

      if (
        type.includes("masuk") ||
        type.includes("setor") ||
        type.includes("tabung") ||
        type.includes("deposit") ||
        type.includes("titipan") ||
        type.includes("saldo masuk") ||
        type.includes("credit")
      ) {
        return saldo + nominal;
      }

      if (
        type.includes("keluar") ||
        type.includes("tarik") ||
        type.includes("bayar") ||
        type.includes("pengeluaran") ||
        type.includes("saldo keluar") ||
        type.includes("debit")
      ) {
        return saldo - nominal;
      }

      return saldo;
    },
    0
  );
}

export function getTutorHonorBalance(
  tutorId: string
): number {
  const database = getDatabase();

  const transactions = Array.isArray(
    database.tutorLedger
  )
    ? database.tutorLedger
    : [];

  return transactions.reduce(
    (saldo, transaction) => {
      const transactionTutorId =
        transaction.tutorId ??
        transaction.idTutor;

      if (
        String(transactionTutorId) !==
        String(tutorId)
      ) {
        return saldo;
      }

      const nominal = parseNumber(
        transaction.nominal ??
        transaction.jumlah ??
        0
      );

      const type = String(
        transaction.type ??
        transaction.tipe ??
        transaction.keterangan ??
        ""
      ).toLowerCase();

      if (
        type.includes("honor") ||
        type.includes("fee") ||
        type.includes("sesi") ||
        type.includes("mengajar")
      ) {
        return saldo + nominal;
      }

      return saldo;
    },
    0
  );
}

export function getTutorDepositBalance(
  tutorId: string
): number {
  const database = getDatabase();

  const transactions = Array.isArray(
    database.tutorLedger
  )
    ? database.tutorLedger
    : [];

  return transactions.reduce(
    (saldo, transaction) => {
      const transactionTutorId =
        transaction.tutorId ??
        transaction.idTutor;

      if (
        String(transactionTutorId) !==
        String(tutorId)
      ) {
        return saldo;
      }

      const nominal = parseNumber(
        transaction.nominal ??
        transaction.jumlah ??
        0
      );

      const type = String(
        transaction.type ??
        transaction.tipe ??
        transaction.keterangan ??
        ""
      ).toLowerCase();

      if (
        type.includes("titipan") ||
        type.includes("deposit") ||
        type.includes("saldo")
      ) {
        if (
          type.includes("keluar") ||
          type.includes("ambil") ||
          type.includes("tarik")
        ) {
          return saldo - nominal;
        }

        return saldo + nominal;
      }

      return saldo;
    },
    0
  );
}

export function getKasLembagaBalance(): number {
  const database = getDatabase();

  const kasTransactions = Array.isArray(database.kas)
    ? database.kas
    : [];

  return kasTransactions.reduce(
    (saldo, transaction) => {
      const nominal = parseNumber(
        transaction.nominal ??
        transaction.jumlah ??
        0
      );

      const type = String(
        transaction.tipe ??
        transaction.type ??
        ""
      ).toLowerCase();

      // Transaksi yang menambah kas lembaga
      if (
        type.includes("masuk") ||
        type.includes("pendapatan") ||
        type.includes("pemasukan") ||
        type.includes("setor") ||
        type.includes("terima") ||
        type.includes("income") ||
        type.includes("credit")
      ) {
        return saldo + nominal;
      }

      // Transaksi yang mengurangi kas lembaga
      if (
        type.includes("keluar") ||
        type.includes("pengeluaran") ||
        type.includes("bayar") ||
        type.includes("penarikan") ||
        type.includes("keluar") ||
        type.includes("expense") ||
        type.includes("debit")
      ) {
        return saldo - nominal;
      }

      return saldo;
    },
    0
  );
}

