   CLEAR LOCAL CACHE
   ========================================================= */

export function clearLocalDatabase(): void {
  safeRemoveItem(
    DB_STORAGE_KEY
  );
}

/* =========================================================
   DUPLICATE PROTECTION
   ========================================================= */

export function hasDuplicateIds(
  items: any[]
): boolean {
  const ids =
    new Set<string>();

  for (
    const item of items
  ) {
    const id =
      getObjectId(item);

    if (!id) {
      continue;
    }

    if (
      ids.has(id)
    ) {
      return true;
    }

    ids.add(id);
  }

  return false;
}

export function removeDuplicateIds<
  T
>(
  items: T[]
): T[] {
  const seen =
    new Set<string>();

  const result: T[] = [];

  for (
    const item of items
  ) {
    const id =
      getObjectId(item);

    if (!id) {
      result.push(item);
      continue;
    }

    if (
      seen.has(id)
    ) {
      continue;
    }

    seen.add(id);

    result.push(item);
  }

  return result;
}

/* =========================================================
   CLEAN DATABASE
   ========================================================= */

export function cleanDatabase(
  database?: Database
): Database {
  const db =
    ensureDatabaseDefaults(
      database ||
        getDatabase()
    );

  return {
    ...db,

    programs:
      removeDuplicateIds(
        db.programs
      ),

    students:
      removeDuplicateIds(
        db.students
      ),

    tutors:
      removeDuplicateIds(
        db.tutors
      ),

    sessions:
      removeDuplicateIds(
        db.sessions
      ),

    studentLedger:
      removeDuplicateIds(
        db.studentLedger
      ),

    payments:
      removeDuplicateIds(
        db.payments
      ),

    tutorLedger:
      removeDuplicateIds(
        db.tutorLedger
      ),

    slips:
      removeDuplicateIds(
        db.slips
      ),

    kas:
      removeDuplicateIds(
        db.kas
      ),

    otherIncomes:
      removeDuplicateIds(
        db.otherIncomes
      ),

    attendanceReports:
      removeDuplicateIds(
        db.attendanceReports
      ),

    schedules:
      removeDuplicateIds(
        db.schedules
      ),

    raports:
      removeDuplicateIds(
        db.raports || []
      ),

    lastUpdated:
      new Date().toISOString(),
  };
}

/* =========================================================
   AUTO CLEAN + SAVE
   ========================================================= */

export function cleanAndSaveDatabase(): Database {
  const cleaned =
    cleanDatabase();

  return saveDatabase(
    cleaned
  );
}

export function generateUniqueId(
  prefix = "ID"
): string {
  const timestamp = Date.now().toString(36);

  const random = Math.random()
    .toString(36)
    .substring(2, 10)
    .toUpperCase();

  return `${prefix}-${timestamp}-${random}`;
}

export function filterByDateRange<T extends Record<string, any>>(
  items: T[],
  startDate?: string | Date | null,
  endDate?: string | Date | null
): T[] {
  if (!Array.isArray(items)) {
    return [];
  }

  if (!startDate && !endDate) {
    return items;
  }

  const getDate = (item: T): Date | null => {
    const value =
      item.tanggal ??
      item.date ??
      item.createdAt ??
      item.created_at;

    if (!value) {
      return null;
    }

    const date = new Date(value);

    return Number.isNaN(date.getTime())
      ? null
      : date;
  };

  const start = startDate
    ? new Date(startDate)
    : null;

  const end = endDate
    ? new Date(endDate)
    : null;

  if (start) {
    start.setHours(0, 0, 0, 0);
  }

  if (end) {
    end.setHours(23, 59, 59, 999);
  }

  return items.filter((item) => {
    const date = getDate(item);

    if (!date) {
      return false;
    }

    if (start && date < start) {
      return false;
    }

    if (end && date > end) {
      return false;
    }

    return true;
  });
}

export function verifyAttendanceReport(
  reportId: string,
  catatanAdmin = ""
): Database {
  const database = getDatabase();

  const report =
    database.attendanceReports.find(
      (item) =>
        String(item.id) ===
        String(reportId)
    );

  if (!report) {
    return database;
  }

  const updatedReport: AttendanceReport = {
    ...report,

    status: "verified",

    catatanAdmin,

    tanggalProses:
      getCurrentTimestamp(),

    updatedAt:
      getCurrentTimestamp(),
  };

  return saveDatabase({
    ...database,

    attendanceReports:
      database.attendanceReports.map(
        (item) =>
          String(item.id) ===
          String(reportId)
            ? updatedReport
            : item
      ),

    lastUpdated:
      getCurrentTimestamp(),
  });
}

export function undoVerifyAttendanceReport(
  reportId: string,
  catatanAdmin = ""
): Database {
  const database = getDatabase();

  const report =
    database.attendanceReports.find(
      (item) =>
        String(item.id) ===
        String(reportId)
    );

  if (!report) {
    return database;
  }

  const updatedReport: AttendanceReport = {
    ...report,

    status: "pending",

    catatanAdmin,

    tanggalProses:
      getCurrentTimestamp(),

    updatedAt:
      getCurrentTimestamp(),
  };

  return saveDatabase({
    ...database,

    attendanceReports:
      database.attendanceReports.map(
        (item) =>
          String(item.id) ===
          String(reportId)
            ? updatedReport
            : item
      ),

    lastUpdated:
      getCurrentTimestamp(),
  });
}

export function deleteSessionTransaction(
  sessionId: string
): Database {
  const database = getDatabase();

  return saveDatabase({
    ...database,

    sessions:
      database.sessions.filter(
        (session) =>
          String(session.id) !==
          String(sessionId)
      ),

    lastUpdated:
      getCurrentTimestamp(),
  });
}

/* =========================================================
   DEFAULT EXPORT
   ========================================================= */


export function checkDuplicateSession(
  siswaId: string,
  tutorId: string,
  tanggal: string,
  excludeSessionId?: string
): boolean {
  const database = getDatabase();

  if (!siswaId || !tutorId || !tanggal) {
    return false;
  }

  const normalizeDate = (value: unknown): string => {
    if (!value) return "";

    const text = String(value);

    if (/^\d{4}-\d{2}-\d{2}$/.test(text)) {
      return text;
    }

    const date = new Date(text);

    if (Number.isNaN(date.getTime())) {
      return text.substring(0, 10);
    }

    return `${date.getFullYear()}-${String(
      date.getMonth() + 1
    ).padStart(2, "0")}-${String(
      date.getDate()
    ).padStart(2, "0")}`;
  };

  const targetDate = normalizeDate(tanggal);

  return database.sessions.some((session) => {
    if (
      excludeSessionId &&
      String(session.id) === String(excludeSessionId)
    ) {
      return false;
    }

    const sessionSiswaId =
      (session as any).siswaId ??
      (session as any).idSiswa;

    const sessionTutorId =
      (session as any).tutorId ??
      (session as any).idTutor;

    const sessionDate = normalizeDate(
      (session as any).tanggal ??
      (session as any).date
    );

    return (
      String(sessionSiswaId) === String(siswaId) &&
      String(sessionTutorId) === String(tutorId) &&
      sessionDate === targetDate
    );
  });
}


export function submitAttendanceReport(
  report: any
): Database {
  const database = getDatabase();

  if (!report) {
    return database;
  }

  const reportId =
    report.id ||
    generateUniqueId("ATT");

  const newReport = {
    ...report,

    id: reportId,

    status:
      report.status ||
      "pending",

    tanggal:
      report.tanggal ||
      getTodayDateString(),

    createdAt:
      report.createdAt ||
      getCurrentTimestamp(),

    updatedAt:
      getCurrentTimestamp(),
  };

  const existingIndex =
    database.attendanceReports.findIndex(
      (item: any) =>
        String(item.id) ===
        String(reportId)
    );

  let attendanceReports;

  if (existingIndex >= 0) {
    attendanceReports =
      database.attendanceReports.map(
        (item: any, index: number) =>
          index === existingIndex
            ? newReport
            : item
      );
  } else {
    attendanceReports = [
      ...database.attendanceReports,
      newReport,
    ];
  }

  return saveDatabase({
    ...database,

    attendanceReports,

    lastUpdated:
      getCurrentTimestamp(),
  });
}

