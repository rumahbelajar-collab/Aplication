/* =========================================================
   BROADCAST
   ========================================================= */

export function setBroadcastMessage(
  message: BroadcastMessage | null
): Database {
  return saveDatabase({
    ...getDatabase(),

    broadcastMessage:
      message
        ? {
            ...message,

            id:
              message.id ||
              generateId("BC"),

            updatedAt:
              getCurrentTimestamp(),
          }
        : null,
  });
}

export function updateBroadcastMessageTransaction(
  message: Partial<BroadcastMessage> | null
): Database {
  const database = getDatabase();

  if (!message) {
    return saveDatabase({
      ...database,
      broadcastMessage: null,
      lastUpdated: getCurrentTimestamp(),
    });
  }

  const existing =
    database.broadcastMessage || {};

  const updatedMessage: BroadcastMessage = {
    ...existing,
    ...message,

    id:
      existing.id ||
      message.id ||
      generateId("BC"),

    updatedAt:
      getCurrentTimestamp(),
  };

  return saveDatabase({
    ...database,

    broadcastMessage:
      updatedMessage,

    lastUpdated:
      getCurrentTimestamp(),
  });
}

export function clearBroadcastMessage(): Database {
  return setBroadcastMessage(null);
}

