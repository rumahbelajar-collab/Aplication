export async function deleteRecordFromSupabase(
  tableName: string,
  recordId: string
): Promise<boolean> {
  try {
    if (!tableName || !recordId) {
      console.error(
        "deleteRecordFromSupabase: tableName dan recordId wajib diisi"
      );

      return false;
    }

    const { error } = await supabase
      .from(tableName)
      .delete()
      .eq("id", recordId);

    if (error) {
      console.error(
        `Gagal menghapus record dari ${tableName}:`,
        error
      );

      return false;
    }

    return true;
  } catch (error) {
    console.error(
      "deleteRecordFromSupabase:",
      error
    );

    return false;
  }
}

/* =========================================================
   SUPABASE
   ========================================================= */

/**
 * Menyimpan database lokal ke Supabase.
 *
 * Struktur tabel:
 *
 * rumah_belajar_db
 * â”œâ”€â”€ id
 * â”œâ”€â”€ data
 * â””â”€â”€ updated_at
 */
export async function saveDatabaseToSupabase(
  database?: Database
): Promise<Database> {
  const db =
    ensureDatabaseDefaults(
      database || getDatabase()
    );

  db.lastUpdated =
    new Date().toISOString();

  const payload = {
    id: DB_ID,

    data: db,

    updated_at:
      db.lastUpdated,
  };

  const { error } =
    await supabase
      .from(SUPABASE_TABLE)
      .upsert(
        payload,
        {
          onConflict: "id",
        }
      );

  if (error) {
    console.error(
      "saveDatabaseToSupabase:",
      error
    );

    throw error;
  }

  saveDatabase(db);

  return db;
}

/* =========================================================
   LOAD DATABASE DARI SUPABASE
   ========================================================= */

export async function loadDatabaseFromSupabase(): Promise<Database | null> {
  const { data, error } =
    await supabase
      .from(SUPABASE_TABLE)
      .select(
        "id,data,updated_at"
      )
      .eq("id", DB_ID)
      .maybeSingle();

  if (error) {
    console.error(
      "loadDatabaseFromSupabase:",
      error
    );

    return null;
  }

  if (!data) {
    return null;
  }

  const remoteDatabase =
    ensureDatabaseDefaults(
      data.data as Partial<Database>
    );

  return remoteDatabase;
}

/* =========================================================
   SYNC DATABASE
   ========================================================= */

export async function syncDatabase(): Promise<Database> {
  const local =
    getDatabase();

  try {
    const remote =
      await loadDatabaseFromSupabase();

    if (!remote) {
      return local;
    }

    const merged =
      mergeDatabases(
        local,
        remote
      );

    saveDatabase(
      merged
    );

    return merged;
  } catch (error) {
    console.error(
      "syncDatabase:",
      error
    );

    return local;
  }
}

/* =========================================================
   BACKUP DATABASE
   ========================================================= */

export function exportDatabaseJSON(): string {
  const database =
    getDatabase();

  return JSON.stringify(
    database,
    null,
    2
  );
}

export function importDatabaseJSON(
  json: string
): Database {
  const parsed =
    JSON.parse(json);

  const database =
    ensureDatabaseDefaults(
      parsed
    );

  saveDatabase(
    database
  );

  return database;
}

/* =========================================================
   DOWNLOAD BACKUP
   ========================================================= */

export function downloadDatabaseBackup(): void {
  if (
    typeof window ===
    "undefined"
  ) {
    return;
  }

  const json =
    exportDatabaseJSON();

  const blob =
    new Blob(
      [json],
      {
        type:
          "application/json",
      }
    );

  const url =
    URL.createObjectURL(
      blob
    );

  const anchor =
    document.createElement(
      "a"
    );

  anchor.href = url;

  anchor.download =
    `rumah-belajar-backup-${getTodayDateString()}.json`;

  document.body.appendChild(
    anchor
  );

  anchor.click();

  document.body.removeChild(
    anchor
  );

  URL.revokeObjectURL(
    url
  );
}

/* =========================================================
   DATABASE VALIDATION
   ========================================================= */

export function validateDatabase(
  database: unknown
): database is Database {
  if (
    !database ||
    typeof database !==
      "object"
  ) {
    return false;
  }

  const db =
    database as any;

  const requiredArrays = [
    "programs",
    "students",
    "tutors",
    "sessions",
    "studentLedger",
    "payments",
    "tutorLedger",
    "slips",
    "kas",
    "otherIncomes",
    "attendanceReports",
    "schedules",
  ];

  return requiredArrays.every(
    (key) =>
      Array.isArray(db[key])
  );
}

/* =========================================================
   AUTO MIGRATION
   ========================================================= */

export function migrateDatabase(
  database: Partial<Database>
): Database {
  const migrated =
    ensureDatabaseDefaults(
      database
    );

  migrated.version =
    DB_VERSION;

  migrated.lastUpdated =
    new Date().toISOString();

  return migrated;
}

