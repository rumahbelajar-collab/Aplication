export function confirmTutorDepositHandover(
  tutorId: string,
  amount: number,
  description = "Konfirmasi titipan tutor"
): Database {
  const database = getDatabase();

  const nominal = parseNumber(amount);

  if (!tutorId || nominal <= 0) {
    return database;
  }

  const transaction: TutorLedger = {
    id: generateUniqueId("TDH"),
    tutorId,
    idTutor: tutorId,
    tanggal: getTodayDateString(),
    type: "titipan_masuk",
    tipe: "titipan_masuk",
    nominal,
    jumlah: nominal,
    status: "confirmed",
    keterangan: description,
    catatan: description,
    createdAt: getCurrentTimestamp(),
    updatedAt: getCurrentTimestamp(),
  };

  return saveDatabase({
    ...database,

    tutorLedger: [
      ...database.tutorLedger,
      transaction,
    ],

    lastUpdated: getCurrentTimestamp(),
  });
}

export function undoTutorDepositHandover(
  tutorId: string,
  amount: number,
  description = "Pembatalan titipan tutor"
): Database {
  const database = getDatabase();

  const nominal = parseNumber(amount);

  if (!tutorId || nominal <= 0) {
    return database;
  }

  const transaction: TutorLedger = {
    id: generateUniqueId("TDH-UNDO"),
    tutorId,
    idTutor: tutorId,
    tanggal: getTodayDateString(),
    type: "titipan_keluar",
    tipe: "titipan_keluar",
    nominal,
    jumlah: nominal,
    status: "cancelled",
    keterangan: description,
    catatan: description,
    createdAt: getCurrentTimestamp(),
    updatedAt: getCurrentTimestamp(),
  };

  return saveDatabase({
    ...database,

    tutorLedger: [
      ...database.tutorLedger,
      transaction,
    ],

    lastUpdated: getCurrentTimestamp(),
  });
}

export function payTutorHonorTransaction(
  tutorId: string,
  amount: number,
  description = "Pembayaran honor tutor",
  ...extraArgs: any[]
): Database {
  const database = getDatabase();

  const nominal = parseNumber(amount);

  if (!tutorId || nominal <= 0) {
    return database;
  }

  const transaction: TutorLedger = {
    id: generateUniqueId("HONOR"),
    tutorId,
    idTutor: tutorId,
    tanggal: getTodayDateString(),
    type: "honor",
    tipe: "honor",
    nominal,
    jumlah: nominal,
    status: "paid",
    keterangan: description,
    catatan: description,
    createdAt: getCurrentTimestamp(),
    updatedAt: getCurrentTimestamp(),
  };

  const slip: Slip = {
    id: generateUniqueId("SLIP"),
    tutorId,
    idTutor: tutorId,
    tanggal: getTodayDateString(),
    nominal,
    jumlah: nominal,
    total: nominal,
    status: "paid",
    keterangan: description,
    catatan: description,
    createdAt: getCurrentTimestamp(),
    updatedAt: getCurrentTimestamp(),
  };

  return saveDatabase({
    ...database,

    tutorLedger: [
      ...database.tutorLedger,
      transaction,
    ],

    slips: [
      ...database.slips,
      slip,
    ],

    lastUpdated: getCurrentTimestamp(),
  });
}

