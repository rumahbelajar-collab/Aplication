/* =========================================================
   DEFAULT DATABASE
   ========================================================= */

export const createEmptyDatabase = (): Database => ({
  version: DB_VERSION,

  programs: [],

  students: [],

  tutors: [],

  sessions: [],

  studentLedger: [],

  payments: [],

  tutorLedger: [],

  slips: [],

  kas: [],

  otherIncomes: [],

  attendanceReports: [],

  schedules: [],

  raports: [],

  broadcastMessage: null,

  lastUpdated: new Date().toISOString(),
});

/* =========================================================
   SAFE STORAGE
   ========================================================= */

export function safeGetItem<T = any>(
  key: string,
  fallback: T | null = null
): T | null {
  try {
    if (typeof window === "undefined") {
      return fallback;
    }

    const raw = window.localStorage.getItem(key);

    if (!raw) {
      return fallback;
    }

    return JSON.parse(raw) as T;
  } catch (error) {
    console.error(`safeGetItem error [${key}]:`, error);
    return fallback;
  }
}

export function safeSetItem<T = any>(
  key: string,
  value: T
): boolean {
  try {
    if (typeof window === "undefined") {
      return false;
    }

    window.localStorage.setItem(
      key,
      JSON.stringify(value)
    );

    return true;
  } catch (error) {
    console.error(`safeSetItem error [${key}]:`, error);

    return false;
  }
}

export function safeRemoveItem(key: string): boolean {
  try {
    if (typeof window === "undefined") {
      return false;
    }

    window.localStorage.removeItem(key);

    return true;
  } catch (error) {
    console.error(`safeRemoveItem error [${key}]:`, error);

    return false;
  }
}

/* =========================================================
   UTILITAS UMUM
   ========================================================= */

export function generateId(prefix = "ID"): string {
  const timestamp = Date.now().toString(36);

  const random = Math.random()
    .toString(36)
    .substring(2, 8)
    .toUpperCase();

  return `${prefix}-${timestamp}-${random}`;
}

export function getTodayDateString(): string {
  const now = new Date();

  const year = now.getFullYear();

  const month = String(
    now.getMonth() + 1
  ).padStart(2, "0");

  const day = String(
    now.getDate()
  ).padStart(2, "0");

  return `${year}-${month}-${day}`;
}

export function formatBulanTahun(
  value?: string | Date | null
): string {
  if (!value) {
    return "-";
  }

  const date =
    value instanceof Date
      ? value
      : new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "-";
  }

  return new Intl.DateTimeFormat(
    "id-ID",
    {
      month: "long",
      year: "numeric",
    }
  ).format(date);
}

export function formatTanggalIndo(
  value?: string | Date | null
): string {
  if (!value) {
    return "-";
  }

  const date =
    value instanceof Date
      ? value
      : new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "-";
  }

  return new Intl.DateTimeFormat(
    "id-ID",
    {
      day: "2-digit",
      month: "long",
      year: "numeric",
    }
  ).format(date);
}

export function getCurrentTimestamp(): string {
  return new Date().toISOString();
}

export function formatRupiah(
  value: number | string | null | undefined
): string {
  const number = Number(value || 0);

  return new Intl.NumberFormat(
    "id-ID",
    {
      style: "currency",
      currency: "IDR",
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    }
  ).format(number);
}

export function parseNumber(
  value: unknown,
  fallback = 0
): number {
  const number = Number(value);

  return Number.isFinite(number)
    ? number
    : fallback;
}

/* =========================================================
   NORMALISASI DATABASE
   ========================================================= */

export function ensureDatabaseDefaults(
  input?: Partial<Database> | null
): Database {
  const defaults = createEmptyDatabase();

  if (!input || typeof input !== "object") {
    return defaults;
  }

  const result: Database = {
    ...defaults,
    ...input,

    programs: Array.isArray(input.programs)
      ? input.programs
      : [],

    students: Array.isArray(input.students)
      ? input.students
      : [],

    tutors: Array.isArray(input.tutors)
      ? input.tutors
      : [],

    sessions: Array.isArray(input.sessions)
      ? input.sessions
      : [],

    studentLedger: Array.isArray(input.studentLedger)
      ? input.studentLedger
      : [],

    payments: Array.isArray(input.payments)
      ? input.payments
      : [],

    tutorLedger: Array.isArray(input.tutorLedger)
      ? input.tutorLedger
      : [],

    slips: Array.isArray(input.slips)
      ? input.slips
      : [],

    kas: Array.isArray(input.kas)
      ? input.kas
      : [],

    otherIncomes: Array.isArray(input.otherIncomes)
      ? input.otherIncomes
      : [],

    attendanceReports:
      Array.isArray(input.attendanceReports)
        ? input.attendanceReports
        : [],

    schedules: Array.isArray(input.schedules)
      ? input.schedules
      : [],

    raports: Array.isArray(input.raports)
      ? input.raports
      : [],

    broadcastMessage:
      input.broadcastMessage ?? null,

    version:
      typeof input.version === "number"
        ? input.version
        : DB_VERSION,

    lastUpdated:
      input.lastUpdated ||
      new Date().toISOString(),
  };

  return result;
}

/* =========================================================
   ARRAY MERGE
   ========================================================= */

function getObjectId(item: any): string | null {
  if (!item || typeof item !== "object") {
    return null;
  }

  const possibleId =
    item.id ??
    item._id ??
    item.uuid ??
    item.ID;

  if (
    possibleId === undefined ||
    possibleId === null ||
    possibleId === ""
  ) {
    return null;
  }

  return String(possibleId);
}

function mergeArray<T>(
  local: T[] = [],
  remote: T[] = []
): T[] {
  const result = [...local];

  const indexById = new Map<string, number>();

  result.forEach((item, index) => {
    const id = getObjectId(item);

    if (id) {
      indexById.set(id, index);
    }
  });

  for (const remoteItem of remote) {
    const remoteId = getObjectId(remoteItem);

    if (!remoteId) {
      result.push(remoteItem);
      continue;
    }

    const existingIndex =
      indexById.get(remoteId);

    if (existingIndex === undefined) {
      indexById.set(
        remoteId,
        result.length
      );

      result.push(remoteItem);
    } else {
      const localItem =
        result[existingIndex];

      result[existingIndex] = {
        ...(localItem as any),
        ...(remoteItem as any),
      };
    }
  }

  return result;
}

/* =========================================================
   MERGE DATABASE
   ========================================================= */

/**
 * Menggabungkan database lokal dan database hasil recovery.
 *
 * Prinsip:
 * - Tidak menghapus data lokal.
 * - Tidak menghapus data remote.
 * - Data dengan ID sama digabung.
 * - Field yang ada di remote akan memperbarui field lokal.
 * - Array baru dari remote ikut dimasukkan.
 */
export function mergeDatabases(
  localDatabase?: Partial<Database> | null,
  remoteDatabase?: Partial<Database> | null
): Database {
  const local = ensureDatabaseDefaults(
    localDatabase
  );

  const remote = ensureDatabaseDefaults(
    remoteDatabase
  );

  const merged: Database = {
    ...local,

    version: Math.max(
      local.version || 0,
      remote.version || 0,
      DB_VERSION
    ),

    programs: mergeArray(
      local.programs,
      remote.programs
    ),

    students: mergeArray(
      local.students,
      remote.students
    ),

    tutors: mergeArray(
      local.tutors,
      remote.tutors
    ),

    sessions: mergeArray(
      local.sessions,
      remote.sessions
    ),

    studentLedger: mergeArray(
      local.studentLedger,
      remote.studentLedger
    ),

    payments: mergeArray(
      local.payments,
      remote.payments
    ),

    tutorLedger: mergeArray(
      local.tutorLedger,
      remote.tutorLedger
    ),

    slips: mergeArray(
      local.slips,
      remote.slips
    ),

    kas: mergeArray(
      local.kas,
      remote.kas
    ),

    otherIncomes: mergeArray(
      local.otherIncomes,
      remote.otherIncomes
    ),

    attendanceReports:
      mergeArray(
        local.attendanceReports,
        remote.attendanceReports
      ),

    schedules: mergeArray(
      local.schedules,
      remote.schedules
    ),

    raports: mergeArray(
      local.raports || [],
      remote.raports || []
    ),

    broadcastMessage:
      remote.broadcastMessage ??
      local.broadcastMessage ??
      null,

    lastUpdated:
      new Date().toISOString(),
  };

  return merged;
}

/* =========================================================
   LOCAL DATABASE
   ========================================================= */

export function getDatabase(): Database {
  const stored =
    safeGetItem<Database>(
      DB_STORAGE_KEY,
      null
    );

  if (!stored) {
    const empty =
      createEmptyDatabase();

    safeSetItem(
      DB_STORAGE_KEY,
      empty
    );

    return empty;
  }

  const normalized =
    ensureDatabaseDefaults(stored);

  return normalized;
}

/* =========================================================
   SAVE DATABASE
   ========================================================= */

export function saveDatabase(
  database: Database
): Database {
  const normalized =
    ensureDatabaseDefaults(database);

  normalized.lastUpdated =
    new Date().toISOString();

  safeSetItem(
    DB_STORAGE_KEY,
    normalized
  );

  return normalized;
}

/* =========================================================
   UPDATE DATABASE
   ========================================================= */

export function updateDatabase(
  updater:
    | Partial<Database>
    | ((current: Database) => Partial<Database>)
): Database {
  const current =
    getDatabase();

  const changes =
    typeof updater === "function"
      ? updater(current)
      : updater;

  return saveDatabase({
    ...current,
    ...changes,
  });
}

/* =========================================================
   RESET DATABASE
   ========================================================= */

export function resetDatabase(): Database {
  const empty =
    createEmptyDatabase();

  saveDatabase(empty);

  return empty;
}

/* =========================================================
   GENERIC ARRAY OPERATIONS
   ========================================================= */

function addToCollection<
  K extends keyof Database
>(
  key: K,
  item: any
): Database {
  const database =
    getDatabase();

  const collection =
    Array.isArray(database[key])
      ? ([...(database[key] as any[])] as any[])
      : [];

  const newItem = {
    ...item,

    id:
      item?.id ||
      generateId(
        String(key)
          .substring(0, 3)
          .toUpperCase()
      ),

    createdAt:
      item?.createdAt ||
      getCurrentTimestamp(),

    updatedAt:
      getCurrentTimestamp(),
  };

  collection.push(newItem);

  return saveDatabase({
    ...database,
    [key]: collection,
  });
}

function updateCollectionItem<
  K extends keyof Database
>(
  key: K,
  id: string,
  updates: Record<string, any>
): Database {
  const database =
    getDatabase();

  const collection =
    Array.isArray(database[key])
      ? (database[key] as any[])
      : [];

  const updated =
    collection.map((item) => {
      if (
        String(item?.id) !==
        String(id)
      ) {
        return item;
      }

      return {
        ...item,
        ...updates,
        updatedAt:
          getCurrentTimestamp(),
      };
    });

  return saveDatabase({
    ...database,
    [key]: updated,
  });
}

function deleteCollectionItem<
  K extends keyof Database
>(
  key: K,
  id: string
): Database {
  const database =
    getDatabase();

  const collection =
    Array.isArray(database[key])
      ? (database[key] as any[])
      : [];

  const filtered =
    collection.filter(
      (item) =>
        String(item?.id) !==
        String(id)
    );

  return saveDatabase({
    ...database,
    [key]: filtered,
  });
}

